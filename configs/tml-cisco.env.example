# tml-cisco.env.example
# Settings for the TML-Cisco container (used by scripts/run-tml-cisco.bash)
#
# Copy this file to configs/tml-cisco.env and fill in the values. The real file
# is ignored by git (.gitignore), so the Confluent Cloud credentials stay local.
#
# BROKERHOSTPORT, CLOUDUSERNAME and CLOUDPASSWORD are the Confluent Cloud
# bootstrap server and API key/secret for your Kafka cluster.

# Docker Hub ID that owns your TML-Cisco image
DOCKERHUB_USER=<dockerhub-username>

# Confluent Cloud (Kafka) connection
BROKERHOSTPORT=<bootstrap-server>:9092
CLOUDUSERNAME=<confluent-api-key>
CLOUDPASSWORD=<confluent-api-secret>

# Topic that the simulated network data is written to
KAFKAPRODUCETOPIC=cisco-network-mainstream

# Dashboard port, PrivateGPT address and how many messages PrivateGPT reads back
VIPERVIZPORT=8080
PGPTIP=http://127.0.0.1
PGPTPORT=8001
PGPTROLLBACK=4
RUNTYPE=-2
